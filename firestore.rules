rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per house. Its id is the SHA-256 of the house passcode,
    // so it can only be opened by someone who knows the passcode.
    // Listing is forbidden, so ids cannot be discovered.
    match /houses/{houseId} {
      allow get: if houseId.matches('^[0-9a-f]{64}$');
      allow list, delete: if false;
      allow create, update: if houseId.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['state', 'updatedAt', 'writer'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 500000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
